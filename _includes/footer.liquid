{% capture footer_contents %}
  &copy; Copyright {{ site.time | date: '%Y' }}
  {{ site.first_name }}
  {{ site.middle_name }}
  {{ site.last_name }}. {{ site.footer_text }}
  {% if site.impressum_path %}
    <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
  {% endif %}
  {% if site.last_updated %}
    Last updated: {{ 'now' | date: '%B %d, %Y' }}.
  {% endif %}
{% endcapture %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      {{ footer_contents }}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% include newsletter.liquid %}
    {% endif %}

    <div class="container">
      {{ footer_contents }}
    </div>
    {% if page.url == '/' and page.visitor_map_src %}
      <!-- Visitor map: home page only, injected after the page has finished loading -->
      <div id="visitor-map" class="visitor-map" data-src="{{ page.visitor_map_src }}"></div>
      <script>
        window.addEventListener('load', function () {
          var box = document.getElementById('visitor-map');
          // the widget inserts a link without text: give it an accessible name
          new MutationObserver(function () {
            var link = box.querySelector('a:not([aria-label])');
            if (link) link.setAttribute('aria-label', 'Visitor map (MapMyVisitors)');
          }).observe(box, { childList: true, subtree: true });
          var inject = function () {
            var s = document.createElement('script');
            s.id = 'mapmyvisitors';
            s.src = box.dataset.src;
            box.appendChild(s);
          };
          if ('requestIdleCallback' in window) {
            requestIdleCallback(inject, { timeout: 4000 });
          } else {
            setTimeout(inject, 2000);
          }
        });
      </script>
    {% endif %}
  </footer>
{% endif %}
